{
  "name": "figma-css-diff",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Compare rendered browser styles against Figma Dev Mode CSS specs to catch spacing, typography, and color discrepancies.",
  "scripts": {
    "test": "node --import tsx scripts/run-tests.ts",
    "test:watch": "node --import tsx scripts/run-tests.ts watch",
    "test:coverage": "node --import tsx scripts/run-tests.ts coverage",
    "test:cli-coverage": "node --import tsx scripts/run-tests.ts coverage --include=cli/*.ts --lines=100 --functions=100",
    "docs:install": "npm --prefix docs-site install",
    "docs:dev": "npm --prefix docs-site run start",
    "docs:build": "npm --prefix docs-site run build",
    "docs:serve": "npm --prefix docs-site run serve",
    "ci:check": "node --import tsx cli/index.ts",
    "build:extension": "esbuild chrome-extension/panel/panel.ts chrome-extension/background/service-worker.ts chrome-extension/content/content.ts chrome-extension/devtools/devtools.ts --bundle --outdir=chrome-extension/dist --platform=browser",
    "build:bridge": "esbuild vscode-bridge/extension.ts --bundle --outdir=vscode-bridge/dist --platform=node --external:vscode",
    "build:cli": "esbuild cli/index.ts --bundle --outfile=dist/ui-checker-ci.js --platform=node",
    "build": "npm run build:extension && npm run build:bridge && npm run build:cli",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.0",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/chrome": "^0.0.266",
    "@types/node": "^20.12.7",
    "@types/vscode": "^1.75.0",
    "@types/ws": "^8.5.10",
    "esbuild": "^0.20.2",
    "semantic-release": "^24.2.9",
    "semantic-release-chrome": "^3.0.0",
    "semantic-release-vsce": "^6.1.3",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "ws": "^8.13.0"
  }
}
