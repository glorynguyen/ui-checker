{
  "name": "ui-checker-bridge",
  "displayName": "UI Checker Bridge",
  "description": "Connects your browser UI-checker to your local workspace.",
  "publisher": "VinhNguyen-Vincent",
  "author": "Vinh Nguyen (Vincent)",
  "icon": "icons/icon.png",
  "version": "2.2.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/glorynguyen/ui-checker.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "package": "vsce package",
    "test": "tsx test-search.ts && tsx test-file-enumerator.ts",
    "test:coverage": "c8 tsx test-search.ts",
    "release": "semantic-release"
  },
  "contributes": {
    "commands": [
      {
        "command": "ui-checker-bridge.startServer",
        "title": "Start UI Checker Bridge Server"
      },
      {
        "command": "ui-checker-bridge.retakeServer",
        "title": "Retake UI Checker Bridge Port"
      },
      {
        "command": "ui-checker-bridge.setupRuntime",
        "title": "Setup UI Checker Runtime (Install & Import)"
      }
    ],
    "configuration": {
      "title": "UI Checker Bridge",
      "properties": {
        "ui-checker-bridge.port": {
          "type": "number",
          "default": 9876,
          "description": "The port the WebSocket server will listen on for connections from the Chrome Extension."
        },
        "ui-checker-bridge.autoTakeover": {
          "type": "boolean",
          "default": true,
          "description": "When enabled, this window will automatically take over the bridge port when it gains focus."
        },
        "ui-checker-bridge.searchExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "tsx",
            "jsx",
            "ts",
            "vue",
            "svelte",
            "astro",
            "html",
            "css",
            "scss",
            "less"
          ],
          "description": "File extensions to search when matching CSS selectors to source files."
        },
        "ui-checker-bridge.additionalExcludePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra glob patterns to exclude from search beyond .gitignore and the built-in safety list (node_modules, dist, .next, etc.)."
        },
        "ui-checker-bridge.maxFileSize": {
          "type": "number",
          "default": 1048576,
          "description": "Files larger than this byte limit are skipped during search (default 1 MB). Prevents scoring minified bundles and lock files."
        }
      }
    }
  },
  "dependencies": {
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.1",
    "c8": "^11.0.0",
    "tsx": "^4.7.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/git": "^10.0.0",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "semantic-release": "^24.2.9",
    "semantic-release-vsce": "^6.1.3"
  }
}
