{
  "name": "ui-checker-bridge",
  "displayName": "UI Checker Bridge",
  "description": "Connects your browser UI-checker to your local workspace.",
  "publisher": "VinhNguyen-Vincent",
  "author": "Vinh Nguyen (Vincent)",
  "icon": "icons/icon.png",
  "version": "2.0.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/glorynguyen/ui-checker.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "package": "vsce package",
    "test": "tsx test-search.ts",
    "test:coverage": "c8 tsx test-search.ts",
    "release": "semantic-release"
  },
  "contributes": {
    "commands": [
      {
        "command": "ui-checker-bridge.startServer",
        "title": "Start UI Checker Bridge Server"
      }
    ],
    "configuration": {
      "title": "UI Checker Bridge",
      "properties": {
        "ui-checker-bridge.port": {
          "type": "number",
          "default": 9876,
          "description": "The port the WebSocket server will listen on for connections from the Chrome Extension."
        },
        "ui-checker-bridge.autoTakeover": {
          "type": "boolean",
          "default": true,
          "description": "When enabled, this window will automatically take over the bridge port when it gains focus."
        }
      }
    }
  },
  "dependencies": {
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.1",
    "c8": "^11.0.0",
    "tsx": "^4.7.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/git": "^10.0.0",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "semantic-release": "^24.2.9",
    "semantic-release-vsce": "^6.1.3"
  }
}
