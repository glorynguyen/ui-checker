{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["chrome", "node", "vscode"],
    "isolatedModules": true
  },
  "include": ["chrome-extension", "vscode-bridge", "cli", "test", "scripts", "test-support"]
}
