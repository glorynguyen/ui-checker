{
  "branches": ["main"],
  "repositoryUrl": "https://github.com/glorynguyen/ui-checker.git",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "releaseRules": [
          { "scope": "vscode-bridge", "release": false },
          { "scope": "bridge", "release": false }
        ]
      }
    ],
    "@semantic-release/release-notes-generator",
    [
      "semantic-release-chrome",
      {
        "extensionId": "khbnahljdhbiafecmjbojhpocmehhbjc",
        "asset": "extension.zip",
        "distFolder": "chrome-extension",
        "manifestPath": "chrome-extension/manifest.json"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["package.json", "chrome-extension/manifest.json"],
        "message": "chore(release): ${nextRelease.version} [skip ci]"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          { "path": "extension.zip", "label": "Chrome Extension (zip)" }
        ]
      }
    ]
  ]
}
